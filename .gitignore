# Python
__pycache__/
*.py[cod]
*.pyc
.ipynb_checkpoints/

# Virtual environment
.venv/

# Generated data (recreated by running the pipeline) - keep the folders, ignore contents
input/*
output/*
reports/*
!input/.gitkeep
!output/.gitkeep
!reports/.gitkeep

# to_upload folder: keep the folder (via .gitkeep), ignore its generated CSVs
!output/to_upload/
output/to_upload/*.csv
!output/to_upload/.gitkeep

